public int getPointsForRow(int targetRow){
  int sumOfRow = 0;
  String storeColor = "";
  for (int c = 0; c < board[0].length; c ++){
      for (int r = 0; r < board.length; r ++){
        if (r = targetRow){
          sumOfRow += board[r][c].getPoints();
        }
        
        if (r == 0){
          storeColor = board[r][c].getColor();
        } else {
          if (board[r][c].getColor().equals(storeColor)){
            sumOfRow *= 2;
          }
        }
      }
    }
    return sumOfRow
}
