public class Bottle {
    private double currCapacity;
    private double initial;
    public Bottle(double milliliters){
        currCapacity = milliliters;
        initial = milliliters;
    }

    public double updateAmount(double removal){
        currCapacity - removal;
        if (currCapacity <= 0.25 * initial){
            currCapacity = initial;
        }

        return currCapacity;
    }
